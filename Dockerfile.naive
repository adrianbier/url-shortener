# syntax=docker/dockerfile:1
# HA 1: Absichtlich ineffizienter Single-Stage-Build.
# Das komplette .NET-SDK und der Quellcode bleiben im fertigen Image.
# Build: docker build -f Dockerfile.naive -t url-shortener:naive .

FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /app

COPY . .
RUN dotnet restore UrlShortener.csproj
RUN dotnet publish UrlShortener.csproj -c Release -o /app/publish

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "/app/publish/UrlShortener.dll"]
